+
+// UberSDR: capture-time anchor.
+//
+// The A/D clock is GPSDO-locked, so the capture time of input sample n is the
+// straight line t0 + n / samprate and only t0 has to be estimated.  Each USB
+// transfer gives one observation: the time its callback ran, minus the time its
+// last sample represents.  That can only exceed t0, by however long the
+// transfer took to reach us, so the floor of the observations over a window --
+// not their mean, which a scheduling tail would drag upward -- estimates t0 plus
+// a constant hardware latency.  The front end knows that latency, so it takes it
+// off the arrival times it passes in (RX888_CAPTURE_LATENCY_NS in rx888.c) and
+// the anchor is t0 itself.  Timestamps are CLOCK_REALTIME, the same clock
+// the kernel stamps received datagrams with, so a receiver on this host can
+// subtract the two directly.
+
+// A move in the floor bigger than this is a re-anchoring, not jitter.  One lost
+// RX888 transfer at the default request size is ~4 ms, so this still catches it.
+#define CAPTURE_STEP_NS (2000000LL)
+// This many transfers in a row all that far above the anchor, spread over at
+// least this long, is a loss nobody flagged.  The span rules out a backlog of
+// transfers completing back to back after the event thread was held up: with
+// queuedepth up to 64 that can be 64 late callbacks inside a millisecond, while
+// a real loss leaves them at their normal ~4 ms spacing
+#define CAPTURE_STEP_RUN 50
+#define CAPTURE_STEP_SPAN_NS (150000000LL)
+
+// Called at the end of each second: fold that second's floor into the published anchor.
+static void capture_publish(struct capture_anchor *a,int64_t finished_sec){
+  int const fi = (int)(finished_sec % CAPTURE_WINDOW);
+  int64_t const latest = a->bucket_min[fi];
+  int64_t floor = INT64_MAX;
+  for(int i=0; i < CAPTURE_WINDOW; i++){
+    if(i == fi || a->bucket_sec[i] == 0 || finished_sec - a->bucket_sec[i] >= CAPTURE_WINDOW)
+      continue;
+    if(a->bucket_min[i] < floor)
+      floor = a->bucket_min[i];
+  }
+  int64_t t0;
+  if(floor == INT64_MAX){
+    t0 = latest; // First complete second since a (re)start
+  } else if(latest - floor > CAPTURE_STEP_NS){
+    // A whole second never got down to the old floor: samples were lost or the
+    // clock stepped forward.  The older seconds no longer describe this stream.
+    for(int i=0; i < CAPTURE_WINDOW; i++)
+      if(i != fi)
+	a->bucket_sec[i] = 0;
+    // New anchor before new generation: capture_mark() reads them the other
+    // way round, so a channel that sees the new generation sees the new anchor
+    atomic_store(&a->t0_ns,latest);
+    atomic_fetch_add(&a->generation,1);
+    if(Verbose)
+      fprintf(stderr,"capture anchor moved %+.3f ms, re-anchored\n",(latest - floor) / 1e6);
+    return;
+  }
+  t0 = floor < latest ? floor : latest;
+  atomic_store(&a->t0_ns,t0);
+}
+
+// Front end sample thread: 'samples_end' input samples have now been received,
+// the last of them in a transfer whose callback started at 'arrival_ns'
+// (CLOCK_REALTIME).  'discontinuity' says samples were lost since the last call.
+void capture_note(struct frontend *frontend,int64_t arrival_ns,uint64_t samples_end,bool discontinuity){
+  if(frontend == NULL || frontend->samprate <= 0)
+    return;
+  struct capture_anchor * const a = &frontend->capture;
+  if(discontinuity){
+    // The sample count no longer matches elapsed time; start over
+    for(int i=0; i < CAPTURE_WINDOW; i++)
+      a->bucket_sec[i] = 0;
+    a->current_sec = 0;
+    a->high_run = 0;
+    atomic_store(&a->t0_ns,0); // Unknown until a full second has been seen
+    atomic_fetch_add(&a->generation,1);
+  }
+  int64_t const offset = arrival_ns - (int64_t)llroundl((long double)samples_end * BILLION / frontend->samprate);
+  int64_t const sec = arrival_ns / BILLION;
+  int const i = (int)(sec % CAPTURE_WINDOW);
+  if(sec != a->current_sec){
+    if(a->current_sec != 0)
+      capture_publish(a,a->current_sec);
+    a->current_sec = sec;
+    a->bucket_sec[i] = sec;
+    a->bucket_min[i] = offset;
+  } else if(offset < a->bucket_min[i])
+    a->bucket_min[i] = offset;
+
+  int64_t const t0 = atomic_load(&a->t0_ns);
+  if(t0 == 0)
+    return;
+  if(offset < t0){
+    // A lower floor is strictly better information, so take it now rather than at the end of the second
+    a->high_run = 0;
+    atomic_store(&a->t0_ns,offset); // before the generation; see capture_publish()
+    if(t0 - offset > CAPTURE_STEP_NS)
+      atomic_fetch_add(&a->generation,1); // Clock stepped back
+  } else if(offset - t0 > CAPTURE_STEP_NS){
+    // Samples lost without a failed transfer, or the clock stepped forward.
+    // capture_publish() would see it too, but only after a whole clean second
+    if(a->high_run == 0){
+      a->high_run_start = arrival_ns;
+      a->high_run_min = offset;
+    } else if(offset < a->high_run_min)
+      a->high_run_min = offset;
+    if(++a->high_run >= CAPTURE_STEP_RUN && arrival_ns - a->high_run_start >= CAPTURE_STEP_SPAN_NS){
+      for(int j=0; j < CAPTURE_WINDOW; j++)
+	a->bucket_sec[j] = 0;
+      a->bucket_sec[i] = sec;           // this second's bucket held pre-step values; restart it
+      a->bucket_min[i] = a->high_run_min;
+      a->high_run = 0;
+      atomic_store(&a->t0_ns,a->bucket_min[i]);
+      atomic_fetch_add(&a->generation,1);
+      if(Verbose)
+	fprintf(stderr,"capture anchor moved %+.3f ms, re-anchored\n",(a->bucket_min[i] - t0) / 1e6);
+    }
+  } else
+    a->high_run = 0;
+}
+
+// Ask response() to send this channel's status on the metadata group within a
+// few blocks, spread by SSRC so an event every channel sees at once (a
+// re-anchoring, a lost transfer) isn't one burst.  A receiver keeps using the
+// last pair it was sent, so it has to hear promptly both when there is a new
+// one and when the old one stopped being valid (status then carries none).
+static void capture_announce(chan_t *chan){
+  pthread_mutex_lock(&chan->status.lock);
+  chan->status.global_timer = 1 + (int)(chan->output.rtp.ssrc & 3);
+  pthread_mutex_unlock(&chan->status.lock);
+}
+
+// Drop the channel's pair, and say so, if it had one.
+static void capture_invalidate(chan_t *chan){
+  if(!chan->output.capture_valid)
+    return;
+  chan->output.capture_valid = false;
+  capture_announce(chan);
+}
+
+// Channel thread, once per block: pair the RTP timestamp that the first frame
+// of the baseband just produced will carry with the time its signal was captured.
+static void capture_mark(chan_t *chan){
+  struct frontend * const frontend = chan->frontend;
+  // Generation first, then anchor: the writer stores them the other way round
+  uint32_t const generation = atomic_load(&frontend->capture.generation);
+  int64_t const t0 = atomic_load(&frontend->capture.t0_ns);
+  if(t0 == 0 || frontend->samprate <= 0 || Blocktime <= 0){
+    capture_invalidate(chan); // e.g. a transfer failed: the anchor is being rebuilt
+    return;
+  }
+  // execute_filter_output() hands back a block of zeros without advancing
+  // sample_index when this channel has fallen a whole ring behind.  Those zeros
+  // still take up a block of timestamps, so the existing pair stays right, but a
+  // new one taken now would be a block out
+  if(chan->output.capture_valid && chan->filter.out.sample_index == chan->output.capture_index)
+    return;
+  // Overlap-save: output frame 0 of this block lines up with the first new input
+  // sample of the block, less the group delay of the linear-phase FIR, which is
+  // centred at (M-1)/2 (see set_filter())
+  int64_t first = (int64_t)chan->filter.out.sample_index;
+  double delay = (frontend->in.impulse_length - 1) / (2.0 * frontend->samprate);
+  if(chan->filter2.blocking > 0){
+    // filter2's output spans its last 'blocking' input blocks, of which this was the last
+    first -= (int64_t)(chan->filter2.blocking - 1) * frontend->in.ilen;
+    double const rate2 = chan->filter.out.olen / Blocktime;
+    delay += (chan->filter2.in.impulse_length - 1) / (2.0 * rate2);
+  }
+  // Frames still queued from earlier blocks go out first, under the current timestamp
+  uint32_t queued = chan->output.queue_length > 0 ? (uint32_t)chan->output.queue_length : 0;
+  if(rtp_clock_rate(chan) != chan->output.samprate && chan->output.samprate > 0)
+    queued = (uint32_t)((uint64_t)queued * OPUS_SAMPRATE / chan->output.samprate);
+
+  // Announce a pair made after the timestamps were re-based (demod restart) or
+  // the anchor re-established, rather than leave it unknown until the next
+  // command's reply
+  bool const announce = !chan->output.capture_valid || generation != chan->output.capture_generation;
+
+  chan->output.capture_ts = chan->output.rtp.timestamp + queued;
+  chan->output.capture_ns = t0 + (int64_t)llroundl(((long double)first / frontend->samprate - delay) * BILLION);
+  chan->output.capture_generation = generation;
+  chan->output.capture_rate = rtp_clock_rate(chan);
+  chan->output.capture_index = chan->filter.out.sample_index;
+  chan->output.capture_valid = true;
+
+  if(announce)
+    capture_announce(chan);
+}
