+// UberSDR additions.  Numbered from the top of the one-byte tag space, in their
+// own enum, so that upstream appending to enum status_type can never renumber
+// or collide with them.
+enum ubersdr_status_type {
+  CAPTURE_TS_REF = 240,     // RTP timestamp of a reference frame, in the stream's own RTP clock
+  CAPTURE_TIME_REF = 241,   // CLOCK_REALTIME (ns since the Unix epoch) at which that frame's signal was captured
+  CAPTURE_GENERATION = 242, // bumped whenever the capture anchor is re-established
+};
